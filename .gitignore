.vscode/settings.json

# Dependencies
node_modules/

# Build output. `build/` is deliberately absent: this repository produces no
# build output, and that directory holds its build *script* — the one thing that
# catches a broken change to what ships. Ignoring it shipped a clean checkout
# with no build in it at all.
dist/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
*.swp

# Tickets live at .claude/tickets/ and are tracked. Position — the per-clone
# state that must never be committed — is defined by .claude/.gitignore.
